<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="olhuz_desktop_completo.Components.ReadingCard"
             x:Name="Root">
    <ContentView.Resources>
        <!-- Cartões das curtas descrições da página de leituras recentes -->
        <Style TargetType="Border"  x:Key="CardReadingHistory">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FDFDFD, Dark={StaticResource DarkContentCardBackground}}"/>
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Título da leitura -->
        <Style TargetType="Label" x:Key="TitleReadingHistory">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorDarkGray}, Dark={StaticResource ColorWhite}}"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="CharacterSpacing" Value="0.2"/>
        </Style>

        <!-- Tipo da leitura -->
        <Style TargetType="Label" x:Key="TypeLabelReadingHistory">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1D44BE, Dark={StaticResource ColorWhite}}"/>
            <Setter Property="MaxLines" Value="1"/>
            <Setter Property="CharacterSpacing" Value="0.2"/>
        </Style>
        
        <!-- Data da leitura -->
        <Style TargetType="Label" x:Key="DateLabelReadingHistory">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorBlack}, Dark={StaticResource ColorWhite}}"/>
            <Setter Property="CharacterSpacing" Value="0.2"/>
        </Style>

    </ContentView.Resources>

    <Border Style="{StaticResource CardReadingHistory}">
        <Border.GestureRecognizers>
            <!-- Card inteiro clicável -->
            <TapGestureRecognizer
                Command="{Binding CardTappedCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Grid
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="20" >
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">
                <Image
                    Grid.Column="0"
                    Source="{Binding ImageUrl, Source={x:Reference Root}}"
                    WidthRequest="140"
                    HeightRequest="110"
                    Aspect="AspectFill"
                    VerticalOptions="Center" />
            </Border>
            <Grid
                Grid.Column="1"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="16"
                VerticalOptions="Center">

                <!-- Tipo da leitura -->
                <Border
                    Grid.Row="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 40"
                    Padding="30, 6"
                    BackgroundColor="#E8EFFC"
                    HorizontalOptions="Start">
                    <Label
                        Text="{Binding TypeText, Source={x:Reference Root}}"
                        Style="{StaticResource TypeLabelReadingHistory}" />
                </Border>

                <!-- Título da leitura -->
                <Label
                    Grid.Row="1"
                    Text="{Binding TitleText, Source={x:Reference Root}}"
                    Style="{StaticResource TitleReadingHistory}" />
            
                <!-- Data da leitura -->
                <Label
                    Grid.Row="2"
                    Text="{Binding DateText, Source={x:Reference Root}}"
                    Style="{StaticResource DateLabelReadingHistory}" />
            </Grid>
            <Image
                Grid.Column="2"
                Source="arrow_right.png"
                WidthRequest="30"
                HeightRequest="30"
                HorizontalOptions="End"
                VerticalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>