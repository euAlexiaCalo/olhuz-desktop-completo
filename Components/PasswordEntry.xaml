<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="olhuz_desktop_completo.Components.PasswordEntry"
             x:Name="Root">

    <VerticalStackLayout Spacing="8">
        <Label Text="{Binding LabelText, Source={x:Reference Root}}" Style="{StaticResource FieldLabelStyle}" />
        <Border Style="{StaticResource FormEntryBorderStyle}">
            <Grid ColumnDefinitions="*,Auto">

                <Entry Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}" 
                       Placeholder="{Binding Placeholder, Source={x:Reference Root}}" 
                       IsPassword="{Binding IsPasswordHidden, Source={x:Reference Root}}"
                       Keyboard="Password" 
                       Style="{StaticResource FormEntryStyle}"/>

                <Image Source="{Binding IconSource, Source={x:Reference Root}}" 
                       Grid.Column="1" HeightRequest="10" Margin="16,0,16,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>