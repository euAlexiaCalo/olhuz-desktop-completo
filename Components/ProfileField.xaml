<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="olhuz_desktop_completo.Components.ProfileField"
    x:Name="Root">

    <Border
        BackgroundColor="#F8FAFC"
        Stroke="#E2E8F0"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 10"
        Padding="14">

        <Grid
            ColumnDefinitions="Auto,*"
            ColumnSpacing="12"
            Padding="5,0"
            VerticalOptions="Center">

            <!-- Ícone -->
            <Border
                    Grid.Column="0"
                    BackgroundColor="#E8EFFC"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="10">
                <Image
                    Grid.Column="0"
                    Source="{Binding IconSource, Source={x:Reference Root}}"
                    WidthRequest="24"
                    HeightRequest="24"
                    VerticalOptions="Center"/>
            </Border>

            <!-- Informações -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">

                <Label
                    Text="{Binding Label, Source={x:Reference Root}}"
                    FontSize="16"
                    TextColor="#606060" />

                <Label
                    Text="{Binding Value, Source={x:Reference Root}}"
                    FontSize="20"
                    TextColor="#222448" />

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>