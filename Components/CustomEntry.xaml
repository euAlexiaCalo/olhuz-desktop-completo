<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="olhuz_desktop_completo.Components.CustomEntry"
             x:Name="CustomEntryControl">

    <VerticalStackLayout Spacing="8" BindingContext="{x:Reference CustomEntryControl}">
        <Label Text="{Binding LabelText}" Style="{StaticResource FieldLabelStyle}"/>
        <Border Style="{StaticResource FormEntryBorderStyle}">
            <Entry Text="{Binding Text, Mode=TwoWay}" 
                   Placeholder="{Binding Placeholder}" 
                   Keyboard="{Binding KeyboardType}"
                   MaxLength="{Binding MaxLength}"
                   Style="{StaticResource FormEntryStyle}"/>
        </Border>
    </VerticalStackLayout>
</ContentView>