<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="olhuz_desktop_completo.Components.HeaderView"
             x:Name="ThisHeader">

    <VerticalStackLayout
        Spacing="10"
        Margin="0, 0, 00, 30"
        BindingContext="{x:Reference ThisHeader}">

        <Label Text="{Binding Title}"
               FontSize="32"
               FontAttributes="Bold"
               TextColor="#111330"
               CharacterSpacing="0.2"/>

        <Label Text="{Binding Description}"
               FontSize="18"
               TextColor="Gray"
               CharacterSpacing="0.2"/>

    </VerticalStackLayout>

</ContentView>