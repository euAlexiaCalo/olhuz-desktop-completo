<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:olhuz_desktop_completo.Components"
             xmlns:enums="clr-namespace:olhuz_desktop_completo.Models.Enums"
             x:Class="olhuz_desktop_completo.Views.Preferences.PreferencesView">
    
    <!-- ========================================================= -->
    <!-- GRID PRINCIPAL DA PÁGINA -->
    <!-- ========================================================= -->
    
    <Grid
        ColumnDefinitions="1,*"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

        <!-- ===================================================== -->
        <!-- LINHA DIVISÓRIA -->
        <!-- ===================================================== -->

        <BoxView
            Grid.Column="0"
            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}"
            VerticalOptions="Fill" />

        <!-- ===================================================== -->
        <!-- CONTEÚDO DA PÁGINA -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1"
            RowDefinitions="Auto, *"
            Padding="30,20"
            MaximumWidthRequest="1400"
            HorizontalOptions="Start"
            VerticalOptions="Start">

            <!-- Cabeçalho -->
            <components:HeaderView
                Grid.Row="0"
                Title="Configurações"
                Description="Personalize sua experiência no Olhuz." />

            <!-- Conteúdo Principal -->
            <ScrollView
                Grid.Row="1"
                VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="30">

                    <!-- SEÇÃO LEITURA DE TELA -->
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Leitura de Tela"
                            Style="{StaticResource SettingsSectionLabel}" />
                    
                        <Border
                            BackgroundColor="White"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="20"
                            HorizontalOptions="Fill">

                        

                            <VerticalStackLayout Spacing="20">

                                <!-- Desativar Leitura de Tela (SWITCH) -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="20,0,20,0">
                                    <Label Grid.Column="0" Text="Desativar Leitura de Tela" Style="{StaticResource ConfigurationLabel}"/>
                                
                                    <Switch Grid.Column="1" 
                                            IsToggled="{Binding ScreenReader}"
                                            Style="{StaticResource SettingSwitch}"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="LightGray" Margin="0" />

                                <!-- Velocidade da Fala (BOTÕES) -->
                                <Grid ColumnDefinitions="*,*" VerticalOptions="Center" Padding="20,0,20,0">
                                    <Label Grid.Column="0" Text="Velocidade da Fala" Style="{StaticResource ConfigurationLabel}" />

                                    <HorizontalStackLayout Grid.Column="1" Style="{StaticResource LayoutSettingsEnd}">
                                        <Button
                                            Text="0.5x"
                                            Command="{Binding SetSpeechRateCommand}"
                                            CommandParameter="0.5"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#000000"
                                            BorderColor="Transparent"
                                            BorderWidth="1"
                                            CornerRadius="24"
                                            Padding="26,8">

                                            <Button.Triggers>
                                                <DataTrigger
                                                    TargetType="Button"
                                                    Binding="{Binding SpeechRate}"
                                                    Value="0.5">

                                                    <Setter Property="BackgroundColor" Value="#1A3885" />
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="BorderColor" Value="#1A3885" />

                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <Button
                                            Text="1.0x"
                                            Command="{Binding SetSpeechRateCommand}"
                                            CommandParameter="1.0"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#000000"
                                            BorderColor="Transparent"
                                            BorderWidth="1"
                                            CornerRadius="24"
                                            Padding="26,8">

                                            <Button.Triggers>
                                                <DataTrigger
                                                    TargetType="Button"
                                                    Binding="{Binding SpeechRate}"
                                                    Value="1.0">

                                                    <Setter Property="BackgroundColor" Value="#1A3885" />
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="BorderColor" Value="#1A3885" />

                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <Button
                                            Text="1.5x"
                                            Command="{Binding SetSpeechRateCommand}"
                                            CommandParameter="1.5"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#000000"
                                            BorderColor="Transparent"
                                            BorderWidth="1"
                                            CornerRadius="24"
                                            Padding="26,8">

                                            <Button.Triggers>
                                                <DataTrigger
                                                    TargetType="Button"
                                                    Binding="{Binding SpeechRate}"
                                                    Value="1.5">

                                                    <Setter Property="BackgroundColor" Value="#1A3885" />
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="BorderColor" Value="#1A3885" />

                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <Button
                                            Text="2.0x"
                                            Command="{Binding SetSpeechRateCommand}"
                                            CommandParameter="2.0"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#000000"
                                            BorderColor="Transparent"
                                            BorderWidth="1"
                                            CornerRadius="24"
                                            Padding="26,8">

                                            <Button.Triggers>
                                                <DataTrigger
                                                    TargetType="Button"
                                                    Binding="{Binding SpeechRate}"
                                                    Value="2.0">

                                                    <Setter Property="BackgroundColor" Value="#1A3885" />
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="BorderColor" Value="#1A3885" />

                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEÇÃO VOZ E FALA -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Voz e Fala" Style="{StaticResource SettingsSectionLabel}" />
                    
                        <Border
                            BackgroundColor="White"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="20"
                            HorizontalOptions="Fill">

                            <VerticalStackLayout Spacing="20">

                                <!-- Tipo de Voz (BOTÕES) -->
                                <Grid ColumnDefinitions="*,*" VerticalOptions="Center" Padding="20,0,20,0">
                                    <Label Text="Tipo de Voz" Style="{StaticResource ConfigurationLabel}" />

                                    <HorizontalStackLayout Grid.Column="1" Style="{StaticResource LayoutSettingsEnd}">
                                        <Button
                                            Text="Feminina"
                                            Command="{Binding SetVoiceTypeCommand}"
                                            CommandParameter="{x:Static enums:VoiceType.Feminina}"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#000000"
                                            BorderColor="Transparent"
                                            BorderWidth="1"
                                            CornerRadius="24"
                                            Padding="26,8">

                                            <Button.Triggers>
                                                <DataTrigger
                                                    TargetType="Button"
                                                    Binding="{Binding VoiceType}"
                                                    Value="0">

                                                    <Setter Property="BackgroundColor" Value="#1A3885" />
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="BorderColor" Value="#1A3885" />

                                                </DataTrigger>
                                            </Button.Triggers>

                                        </Button>
                                        <Button
                                            Text="Masculina"
                                            Command="{Binding SetVoiceTypeCommand}"
                                            CommandParameter="{x:Static enums:VoiceType.Masculina}"
                                            BackgroundColor="#E0E0E0"
                                            TextColor="#000000"
                                            BorderColor="Transparent"
                                            BorderWidth="1"
                                            CornerRadius="24"
                                            Padding="26,8">

                                            <Button.Triggers>
                                                <DataTrigger
                                                    TargetType="Button"
                                                    Binding="{Binding VoiceType}"
                                                    Value="1">

                                                    <Setter Property="BackgroundColor" Value="#1A3885" />
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="BorderColor" Value="#1A3885" />

                                                </DataTrigger>
                                            </Button.Triggers>

                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="LightGray" Margin="0" />

                                <!-- Volume do Som (SLIDER e BOTÕES +/-) -->
                                <Grid ColumnDefinitions="2*,8*" VerticalOptions="Center" Padding="20,0,20,0">
                                    <Label Grid.Column="0" Text="Volume do Som" Style="{StaticResource ConfigurationLabel}" />

                                    <HorizontalStackLayout Grid.Column="1" Style="{StaticResource LayoutSettingsEnd}">
                                        <Button Text="-" Command="{Binding AdjustVolumeCommand}" CommandParameter="Down" Style="{StaticResource VolumeButtonStyle}" />

                                        <Slider Style="{StaticResource SlideStyle}" 
                                                Minimum="0" Maximum="100" 
                                                Value="{Binding VolumeLevel}" />

                                        <Button Text="+" Command="{Binding AdjustVolumeCommand}" CommandParameter="Up" Style="{StaticResource VolumeButtonStyle}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEÇÃO 3 INTERFACE -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Interface" Style="{StaticResource SettingsSectionLabel}" />

                        <Border
                            BackgroundColor="White"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="20"
                            HorizontalOptions="Fill">

                            <Grid ColumnDefinitions="*,*" Padding="20,0,20,0">
                                <Label Grid.Column="0" Text="Modo de Exibição" Style="{StaticResource ConfigurationLabel}" />

                                <HorizontalStackLayout Grid.Column="1" Style="{StaticResource LayoutSettingsEnd}">
                                    <Button
                                        Text="Claro"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="{x:Static enums:ThemeType.Light}"
                                        BackgroundColor="#E0E0E0"
                                        TextColor="#000000"
                                        BorderColor="Transparent"
                                        BorderWidth="1"
                                        CornerRadius="24"
                                        Padding="26,8">

                                        <Button.Triggers>
                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding Theme}"
                                                Value="0">

                                                <Setter Property="BackgroundColor" Value="#1A3885" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#1A3885" />

                                            </DataTrigger>
                                        </Button.Triggers>

                                    </Button>
                                    <Button
                                        Text="Escuro"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="{x:Static enums:ThemeType.Dark}"
                                        BackgroundColor="#E0E0E0"
                                        TextColor="#000000"
                                        BorderColor="Transparent"
                                        BorderWidth="1"
                                        CornerRadius="24"
                                        Padding="26,8">

                                        <Button.Triggers>
                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding Theme}"
                                                Value="1">

                                                <Setter Property="BackgroundColor" Value="#1A3885" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#1A3885" />

                                            </DataTrigger>
                                        </Button.Triggers>

                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEÇÃO NOTIFICAÇÕES -->
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Notificações e Sensores"
                            Style="{StaticResource SettingsSectionLabel}" />

                        <Border
                            BackgroundColor="White"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="20"
                            HorizontalOptions="Fill">



                            <VerticalStackLayout Spacing="20">

                                <!-- Vibração (SWITCH) -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="20,0,20,0">
                                    <Label Grid.Column="0" Text="Vibração" Style="{StaticResource ConfigurationLabel}"/>

                                    <Switch Grid.Column="0" 
                                        IsToggled="{Binding VibrationEnabled}"
                                        Style="{StaticResource SettingSwitch}"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="LightGray" Margin="0" />

                                <!-- Vibração (SWITCH) -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="20,0,20,0">
                                    <Label Grid.Column="0" Text="Sons de alerta" Style="{StaticResource ConfigurationLabel}"/>

                                    <Switch Grid.Column="1" 
                                        IsToggled="{Binding AlertSoundEnabled}"
                                        Style="{StaticResource SettingSwitch}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>