<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:olhuz_desktop_completo.Components"
    x:Class="olhuz_desktop_completo.Views.Readings.ReadingDetailsView"
    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121212}">

    <!-- ========================================================= -->
    <!-- GRID PRINCIPAL DA PÁGINA -->
    <!-- ========================================================= -->

    <Grid
        ColumnDefinitions="1,*"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

        <!-- ===================================================== -->
        <!-- LINHA DIVISÓRIA -->
        <!-- ===================================================== -->

        <BoxView
            Grid.Column="0"
            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}"
            VerticalOptions="Fill" />

        <!-- ===================================================== -->
        <!-- CONTEÚDO DA PÁGINA -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,Auto,*"
            Padding="30,20"
            MaximumWidthRequest="1400"
            HorizontalOptions="Start"
            VerticalOptions="Fill">

            <!-- ================================================= -->
            <!-- CABEÇALHO -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*"
                Margin="0,0,0,16"
                HorizontalOptions="Fill">

                <!-- Botão voltar -->
                <components:BackButton
                    Grid.Column="0"
                    BackCommand="{Binding BackCommand}" />

                <!-- Título -->
                <Label
                    Grid.Column="1"
                    Text="Leitura"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#111330"
                    VerticalTextAlignment="Center"
                    VerticalOptions="Center" />

            </Grid>


            <!-- ================================================= -->
            <!-- CARD PRINCIPAL DA LEITURA -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="20"
                HorizontalOptions="Fill">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20"
                    VerticalOptions="Center">

                    <!-- ========================================= -->
                    <!-- IMAGEM -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HorizontalOptions="Fill">

                        <Image
                            Source="{Binding Reading.ImageUrl}"
                            WidthRequest="140"
                            HeightRequest="110"
                            Aspect="AspectFill"
                            VerticalOptions="Center" />

                    </Border>


                    <!-- ========================================= -->
                    <!-- INFORMAÇÕES -->
                    <!-- ========================================= -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="12">

                        <!-- Título -->
                        <Label
                            Text="{Binding Reading.Title}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="Black" />

                        <!-- Data -->
                        <Label
                            Text="{Binding Reading.UploadDate}"
                            FontSize="14"
                            TextColor="#666666" />

                        <!-- Tipo -->
                        <Border
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 5"
                            BackgroundColor="White"
                            Padding="16,8"
                            HorizontalOptions="Start">

                            <Label
                                Text="{Binding Reading.Type}"
                                FontSize="16"
                                TextColor="#333333" />

                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- DESCRIÇÃO + CONVERSA -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="14"
                RowDefinitions="*"
                Margin="0,14,0,0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">


                <!-- ================================================= -->
                <!-- COLUNA ESQUERDA -->
                <!-- ================================================= -->

                <Grid
                    Grid.Column="0"
                    RowDefinitions="*,Auto,Auto"
                    RowSpacing="14"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">


                    <!-- ========================================= -->
                    <!-- CARD - DESCRIÇÃO -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="0"
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="20"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">

                        <Grid
                            RowDefinitions="Auto,*"
                            RowSpacing="16">

                            <!-- Título -->
                            <Label
                                Grid.Row="0"
                                Text="Descrição"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="Black" />

                            <!-- Texto com rolagem -->
                            <ScrollView
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Default">

                                <Label
                                    Text="{Binding Reading.DescriptionText}"
                                    FontSize="18"
                                    TextColor="#4A4A4A"
                                    CharacterSpacing="0.2"
                                    LineHeight="1.4" />

                            </ScrollView>

                        </Grid>

                    </Border>


                    <!-- ========================================= -->
                    <!-- CARD - INFORMAÇÕES DO ARQUIVO -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="1"
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="20"
                        HorizontalOptions="Fill">

                        <VerticalStackLayout
                            Spacing="12">

                            <!-- Título -->
                            <Label
                                Text="Informações do arquivo"
                                FontSize="18"
                                Margin="0,0,0,4"
                                FontAttributes="Bold"
                                TextColor="Black" />


                            <!-- ================================= -->
                            <!-- NOME DO ARQUIVO -->
                            <!-- ================================= -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Image
                                    Grid.Column="0"
                                    Source="file.png"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Aspect="Fill"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="6">

                                    <Label
                                        Text="Nome do arquivo"
                                        FontSize="15"
                                        TextColor="#888888" />

                                    <Label
                                        Text="{Binding Reading.FileName}"
                                        FontSize="17"
                                        TextColor="Black" />

                                </VerticalStackLayout>

                            </Grid>


                            <!-- Divisor -->
                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#EFEFEF" />


                            <!-- ================================= -->
                            <!-- DATA DO UPLOAD -->
                            <!-- ================================= -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Image
                                    Grid.Column="0"
                                    Source="calendar.png"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Aspect="Fill"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="6">

                                    <Label
                                        Text="Data do upload"
                                        FontSize="15"
                                        TextColor="#888888" />

                                    <Label
                                        Text="{Binding Reading.UploadDate}"
                                        FontSize="17"
                                        TextColor="Black" />

                                </VerticalStackLayout>

                            </Grid>


                            <!-- Divisor -->
                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#EFEFEF" />


                            <!-- ================================= -->
                            <!-- TAMANHO -->
                            <!-- ================================= -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Image
                                    Grid.Column="0"
                                    Source="folder.png"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Aspect="Fill"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="6">

                                    <Label
                                        Text="Tamanho"
                                        FontSize="15"
                                        TextColor="#888888" />

                                    <Label
                                        Text="{Binding Reading.FileSize}"
                                        FontSize="17"
                                        TextColor="Black" />

                                </VerticalStackLayout>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ========================================= -->
                    <!-- CARD - AÇÕES -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="2"
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="20"
                        HorizontalOptions="Fill">

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="2">

                            <!-- Ouvir -->
                            <Button
                                Grid.Column="0"
                                Text="Ouvir descrição"
                                Command="{Binding SpeakDescriptionCommand}"
                                FontSize="16"
                                TextColor="#0066CC"
                                BackgroundColor="Transparent"
                                BorderWidth="0" />

                            <!-- Copiar -->
                            <Button
                                Grid.Column="1"
                                Text="Copiar texto"
                                Command="{Binding CopyTextCommand}"
                                FontSize="16"
                                TextColor="#333333"
                                BackgroundColor="Transparent"
                                BorderWidth="0" />

                            <!-- Excluir -->
                            <Button
                                Grid.Column="2"
                                Text="Excluir"
                                Command="{Binding DeleteReadingCommand}"
                                FontSize="16"
                                TextColor="#D9534F"
                                BackgroundColor="Transparent"
                                BorderWidth="0" />

                        </Grid>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- COLUNA DIREITA - CONVERSA -->
                <!-- ================================================= -->

                <Border
                    Grid.Column="1"
                    Grid.Row="0"
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="20"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                    <Grid
                        RowDefinitions="Auto,*,Auto,Auto"
                        RowSpacing="16">

                        <!-- ========================================= -->
                        <!-- TÍTULO -->
                        <!-- ========================================= -->

                        <Label
                            Grid.Row="0"
                            Text="Conversa"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Black" />


                        <!-- ========================================= -->
                        <!-- MENSAGENS -->
                        <!-- ========================================= -->

                        <ScrollView
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Default">

                            <VerticalStackLayout
                                Spacing="14">


                                <!-- ================================= -->
                                <!-- ASSISTENTE -->
                                <!-- ================================= -->

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="12">

                                    <Frame
                                        Grid.Column="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#E3F2FD"
                                        Padding="0"
                                        HasShadow="False">

                                        <Label
                                            Text="U"
                                            TextColor="#1565C0"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Frame>

                                    <Frame
                                        Grid.Column="1"
                                        BackgroundColor="#F1F3F4"
                                        CornerRadius="12"
                                        Padding="12"
                                        HasShadow="False">

                                        <Label
                                            Text="Olá! Sou seu assistente de leitura. Você pode me perguntar sobre o conteúdo deste arquivo, pedir mais detalhes ou destacar partes específicas."
                                            TextColor="#333333"
                                            FontSize="16" />

                                    </Frame>

                                </Grid>


                                <!-- ================================= -->
                                <!-- USUÁRIO -->
                                <!-- ================================= -->

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">

                                    <Frame
                                        Grid.Column="0"
                                        BackgroundColor="#E8F0FE"
                                        CornerRadius="12"
                                        Padding="12"
                                        HasShadow="False"
                                        HorizontalOptions="End">

                                        <Label
                                            Text="Quais são as cores predominantes na imagem?"
                                            TextColor="#1A73E8"
                                            FontSize="16" />

                                    </Frame>

                                    <Frame
                                        Grid.Column="1"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#0C5CD5"
                                        Padding="0"
                                        HasShadow="False">

                                        <Label
                                            Text="A"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Frame>

                                </Grid>


                                <!-- ================================= -->
                                <!-- ASSISTENTE -->
                                <!-- ================================= -->

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="12">

                                    <Frame
                                        Grid.Column="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#E3F2FD"
                                        Padding="0"
                                        HasShadow="False">

                                        <Label
                                            Text="U"
                                            TextColor="#1565C0"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Frame>

                                    <Frame
                                        Grid.Column="1"
                                        BackgroundColor="#F1F3F4"
                                        CornerRadius="12"
                                        Padding="12"
                                        HasShadow="False">

                                        <Label
                                            Text="As cores predominantes são laranja e amarelo. O laranja e o amarelo estão no céu e no reflexo do sol."
                                            TextColor="#333333"
                                            FontSize="16" />

                                    </Frame>

                                </Grid>


                                <!-- ================================= -->
                                <!-- USUÁRIO -->
                                <!-- ================================= -->

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">

                                    <Frame
                                        Grid.Column="0"
                                        BackgroundColor="#E8F0FE"
                                        CornerRadius="12"
                                        Padding="12"
                                        HasShadow="False"
                                        HorizontalOptions="End">

                                        <Label
                                            Text="Tem pessoas na imagem?"
                                            TextColor="#1A73E8"
                                            FontSize="16" />

                                    </Frame>

                                    <Frame
                                        Grid.Column="1"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#0056B3"
                                        Padding="0"
                                        HasShadow="False">

                                        <Label
                                            Text="A"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Frame>

                                </Grid>


                                <!-- ================================= -->
                                <!-- ASSISTENTE -->
                                <!-- ================================= -->

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="12">

                                    <Frame
                                        Grid.Column="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#E3F2FD"
                                        Padding="0"
                                        HasShadow="False">

                                        <Label
                                            Text="U"
                                            TextColor="#1565C0"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Frame>

                                    <Frame
                                        Grid.Column="1"
                                        BackgroundColor="#F1F3F4"
                                        CornerRadius="12"
                                        Padding="12"
                                        HasShadow="False">

                                        <Label
                                            Text="Não, não há pessoas na imagem. Apenas pegadas na areia."
                                            TextColor="#333333"
                                            FontSize="16" />

                                    </Frame>

                                </Grid>

                            </VerticalStackLayout>

                        </ScrollView>


                        <!-- ========================================= -->
                        <!-- CAMPO DE PERGUNTA -->
                        <!-- ========================================= -->

                        <Grid
                            Grid.Row="2"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">

                            <Border
                                Grid.Column="0"
                                Stroke="#CCCCCC"
                                StrokeShape="RoundRectangle 22"
                                BackgroundColor="White"
                                HeightRequest="44">

                                <Entry
                                    Placeholder="Faça uma pergunta sobre este arquivo..."
                                    FontSize="16"
                                    VerticalOptions="Center"
                                    BackgroundColor="Transparent" />

                            </Border>

                            <ImageButton
                                Grid.Column="1"
                                Source="microphone.png"
                                Aspect="Fill"
                                WidthRequest="44"
                                HeightRequest="44"
                                CornerRadius="22"
                                Padding="8"
                                BackgroundColor="#0C5CD5"/>

                        </Grid>


                        <!-- ========================================= -->
                        <!-- RODAPÉ -->
                        <!-- ========================================= -->

                        <Label
                            Grid.Row="3"
                            Text="As respostas são baseadas na descrição gerada pelo app."
                            FontSize="14"
                            TextColor="#888888"
                            HorizontalTextAlignment="Center" />

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>