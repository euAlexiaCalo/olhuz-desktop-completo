<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:olhuz_desktop_completo.Components"
             x:Class="olhuz_desktop_completo.Views.Readings.ReadingHistoryView">

    <!-- ========================================================= -->
    <!-- GRID PRINCIPAL DA PÁGINA -->
    <!-- ========================================================= -->

    <Grid
        ColumnDefinitions="1,*"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

        <!-- ===================================================== -->
        <!-- LINHA DIVISÓRIA -->
        <!-- ===================================================== -->

        <BoxView
        Grid.Column="0"
        BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}"
        VerticalOptions="Fill" />

        <!-- ===================================================== -->
        <!-- CONTEÚDO DA PÁGINA -->
        <!-- ===================================================== -->

        <Grid
            Grid.Column="1"
            RowDefinitions="2*, 8*"
            Padding="30,20"
            MaximumWidthRequest="1400"
            HorizontalOptions="Start"
            VerticalOptions="Start">

            <components:HeaderView
                Grid.Row="0"
                Title="Histórico de Leituras"
                Description="Consulte suas leituras realizadas anteriormente." />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding ReadingsList}"
                    Spacing="16">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <components:ReadingCard
                                ImageUrl="{Binding ImageUrl}"
                                TypeText="{Binding Type}"
                                TitleText="{Binding Title}"
                                DateText="{Binding UploadDate}"
                                CommandParameter="{Binding .}"
                                CardTappedCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectReadingCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>